(export (version "E")
  (design
    (source "design.json")
    (date "2026-11-04")
    (tool "workbuddy-agent"))
  (components
    (comp (ref "LED1") (value "红色") (footprint "0805")
      (libsource (lib "Device") (part "LED")))
    (comp (ref "LED2") (value "红色") (footprint "0805")
      (libsource (lib "Device") (part "LED")))
    (comp (ref "R1") (value "220Ω") (footprint "0805")
      (libsource (lib "Device") (part "R")))
    (comp (ref "R2") (value "220Ω") (footprint "0805")
      (libsource (lib "Device") (part "R")))
    (comp (ref "SW1") (value "轻触开关") (footprint "6x6mm")
      (libsource (lib "Device") (part "SW_Push")))
    (comp (ref "BAT1") (value "2节电池座") (footprint "2xAA")
      (libsource (lib "Connector") (part "Conn_01x02")))
  )
  (nets
    (net (code "1") (name "VCC")
      (node (ref "BAT1") (pin "1"))
