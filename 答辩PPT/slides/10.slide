        ].map((n, i) => (
          <Box key={i} style={{ flex: 1, background: '#F7F9FC', border: '1px solid #E5E7EB', borderRadius: 6, padding: 12, flexDirection: 'row', alignItems: 'center', gap: 16 }}>
            <Text style={{ fontSize: 19, color: '#1A2230', flex: 1 }}>{n[0]}</Text>
            <Text style={{ fontSize: 20, fontWeight: 'bold', color: n[3] }}>{n[1]} 分</Text>
            <Text style={{ fontSize: 17, color: n[3], width: 76, textAlign: 'right' }}>{n[2]}</Text>
          </Box>
        ))}
      </Box>
      <Box style={{ flex: 1, background: '#F0F5FC', border: '1px solid #D6DCE5', borderRadius: 6, padding: 18, flexDirection: 'column', gap: 10 }}>
        <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#0E3F8C' }}>W8 四样交付物</Text>
        <Text style={{ fontSize: 19, color: '#1A2230', lineHeight: 1.7 }}>✓ 代码仓库 + README<br />✓ 设计报告（Word）<br />✓ 答辩 PPT（本文件）<br />○ 演示视频（待录制）</Text>
        <Box style={{ height: 1, background: '#C9DCF5' }} />
        <Text style={{ fontSize: 18, color: '#4A5568', lineHeight: 1.5 }}>后续展望：多 Agent 协作、仿真评测</Text>
