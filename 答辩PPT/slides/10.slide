    <Box style={{ height: 150, background: '#1E4FA8', borderRadius: 6, padding: 24, flexDirection: 'column', justifyContent: 'center', gap: 12, alignItems: 'center' }}>
      <Text style={{ fontSize: 52, fontWeight: 'bold', color: '#FFFFFF' }}>谢谢，请批评指正</Text>
      <Text style={{ fontSize: 22, color: '#C9DCF5' }}>张熙玥 · 山东大学 · 2026 年 11 月</Text>
    </Box>
